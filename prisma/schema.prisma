generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  new
  contacted
  archived
  closed
}

enum UserRole {
  user
  admin
}

enum ProjectStatus {
  pending_verification
  accepted
  declined
  in_progress
  review
  planning
  completed
  cancelled
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
  under_review
}

model ContactSubmission {
  id        String           @id @default(cuid())
  name      String
  email     String
  company   String?
  budget    String
  service   String
  message   String
  status    SubmissionStatus @default(new)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@index([email])
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  password          String?
  role              UserRole  @default(user)
  emailVerified     Boolean   @default(false)
  phone             String?
  company           String?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
  projects          Project[]
  invoices          Invoice[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  userId      String?
  title       String
  service     String
  status      ProjectStatus @default(pending_verification)
  budget      String?
  description String?
  verifyToken String?       @unique
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoices    Invoice[]

  @@index([userId])
  @@index([status, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  userId        String
  projectId     String?
  amount        Decimal
  status        InvoiceStatus @default(pending)
  dueDate       DateTime?
  paymentRef    String?
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, dueDate])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  unsubscribeToken String?  @unique
  createdAt        DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  newEmail  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
